---
// =============================================================
// Hero — slim identity strip. One line: name, location,
// contact, LinkedIn. Gets out of the way immediately.
// =============================================================
---

<section class="hero" data-hero>
  <div class="hero__inner container">
    <span class="hero__name">Charlie Loughran</span>
    <span class="hero__sep" aria-hidden="true">·</span>
    <span class="hero__item">London, UK</span>
    <span class="hero__sep" aria-hidden="true">·</span>
    <a href="mailto:charlie.loughran@outlook.com" class="hero__item hero__link">charlie.loughran@outlook.com</a>
    <span class="hero__sep" aria-hidden="true">·</span>
    <a href="https://linkedin.com/in/charlie-loughran" target="_blank" rel="noreferrer" class="hero__item hero__link">
      LinkedIn
      <svg width="11" height="11" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M4 12L12 4M12 4H6M12 4v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
    <span class="hero__sep" aria-hidden="true">·</span>
    <a href="/CharlieLoughran_CV.pdf" download class="hero__item hero__link">
      Download CV
      <svg width="11" height="11" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M8 3v7M5 7l3 3 3-3M3 13h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
</section>
