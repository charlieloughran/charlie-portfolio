---
import type { CollectionEntry } from "astro:content";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;

const hasContent = (project: CollectionEntry<"projects">) =>
  (project.body?.trim().split(/\s+/).length ?? 0) > 50;
---

<section class="portfolio section-padding" id="work" data-reveal-section>
  <div class="container">
    <div class="portfolio__header" data-reveal>
      <div class="portfolio__eyebrow">Selected Work</div>
      <h2 class="portfolio__title">Case studies &amp;<br /><em>recent projects</em></h2>
      <p class="portfolio__description">A selection of UX projects across three years of work and study.</p>
    </div>
  </div>

  <div class="portfolio__grid" data-portfolio-grid>
    {projects.map((project, index) => (
      <a
        href={`/projects/${project.data.slug}`}
        class="portfolio__card"
        style={`--color-card-accent: ${project.data.accent}`}
        data-reveal
        data-reveal-delay={Math.min(index + 1, 3)}
      >
        <div class="portfolio__media">
          {project.data.coverImage ? (
            <img
              class="portfolio__image"
              src={project.data.coverImage}
              alt={project.data.title}
              width="800"
              height="500"
              loading={index === 0 ? "eager" : "lazy"}
              decoding="async"
            />
          ) : (
            <div class="portfolio__placeholder">
              <div class="portfolio__placeholder-shape" aria-hidden="true" />
            </div>
          )}
        </div>

        {!hasContent(project) && (
          <span class="portfolio__coming-soon" aria-label="Coming soon">Coming Soon</span>
        )}
        <div class="portfolio__body">
          <div class="portfolio__meta">
            <span class="portfolio__year">{project.data.year}</span>
            <span class="portfolio__client">{project.data.client}</span>
          </div>
          <h3 class="portfolio__card-title">{project.data.title}</h3>
          <p class="portfolio__subtitle">{project.data.subtitle}</p>
          {project.data.description && (
            <p class="portfolio__description-text">{project.data.description}</p>
          )}
        </div>

        <div class="portfolio__arrow" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
            <path d="M4 14L14 4M14 4H7M14 4V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </a>
    ))}
  </div>
</section>
