---
// =============================================================
// About
// Intro/bio header, skills summary grid, and experience timeline.
// =============================================================

const skills = [
  {
    category: "Design & UI",
    items: ["Figma", "Adobe InDesign", "Illustrator", "Photoshop", "Layout Design", "Typography", "Brand Identity"],
  },
  {
    category: "UX",
    items: ["User-Centred Design", "Wireframing", "Prototyping", "UX Auditing", "Information Architecture", "Interaction Design", "Accessible Design"],
  },
  {
    category: "Web & CMS",
    items: ["React", "TypeScript", "Vite", "WordPress", "Umbraco", "Website Architecture"],
  },
  {
    category: "Marketing",
    items: ["Digital Marketing", "LinkedIn B2B", "Google Ads", "Analytics", "Content Strategy"],
  },
];

const timeline = [
  {
    date: "Mar 2026 – Present",
    role: "UI Designer (Contract)",
    company: "University of Salford",
    detail: "Dashboard UI for a UK decarbonisation tool, including a UX audit, hi-fi wireframes, and a full colour system.",
  },
  {
    date: "Jan 2026 – Present",
    role: "Creative Designer & Marketing Lead",
    company: "Harvest Communications",
    detail: "Designing and developing the company website, plus artworking theatre programmes for West End & touring productions across the UK & Ireland.",
  },
  {
    date: "Oct 2024 – Present",
    role: "Freelance Designer",
    company: "LOCRN Ltd",
    detail: "Independent designer delivering print, brand, and digital work across theatre, wellness, and education.",
  },
  {
    date: "Jan 2025 – Dec 2025",
    role: "Marketing Officer",
    company: "University of Salford",
    detail: "Reinforced brand identity across the Centre for Sustainable Innovation's digital and physical presence, including LinkedIn, Google Ads, and Power BI.",
  },
  {
    date: "Jun 2023 – Oct 2024",
    role: "Graphic & Digital Designer",
    company: "HTDL",
    detail: "Led design system improvements, designing and delivering work for 100+ productions across 50+ venues for a major UK & Ireland theatre operator.",
  },
];
---

<section class="about section-padding" id="about" data-reveal-section>
  <div class="container">
    <div class="about__header" data-reveal>
      <span class="about__eyebrow">About</span>
      <div class="about__intro">
        <h2 class="about__title">
          Design that works<br />
          <em>for the people using it</em>
        </h2>
        <p class="about__bio">
          I'm a Digital Designer who loves that moment a confusing interface clicks into place — for the person using it, and for me. My work spans UX, web, brand, and print, and I've had the chance to work with some brilliant clients across sport, arts, sustainability, and higher education: turning unusable dashboards into ones people actually enjoy, building websites that bring in real leads, and keeping brands looking sharp even when things move fast. I'm endlessly curious, and genuinely happiest when I'm learning something new.
        </p>
        <!-- <p class="about__bio">
          I bring the same precision to a user flow as I do to a page layout —
          and it's that intersection of UX/UI and digital design, where the
          work has a tangible impact, that I find most rewarding.
        </p> -->
        <div class="about__education">
          <span class="about__edu-badge">
            BA (Hons) Digital Media &amp; XR
            <span class="about__edu-separator" aria-hidden="true">·</span>
            University of Salford
            <span class="about__edu-separator" aria-hidden="true">·</span>
            First Class Honours
          </span>
        </div>
      </div>
    </div>

    <div class="about__skills" data-reveal data-reveal-delay="1">
      {
        skills.map((group) => (
          <div class="about__skill-group">
            <h4 class="about__skill-title">{group.category}</h4>
            <div class="about__skill-list">
              {group.items.map((item) => (
                <span class="about__skill-item">{item}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <div class="about__timeline-wrap" data-reveal data-reveal-delay="2">
      <h3 class="about__timeline-title">Experience</h3>
      <ol class="about__timeline">
        {
          timeline.map((entry) => (
            <li class="about__timeline-item">
              <div class="about__timeline-dot" aria-hidden="true" />
              <div class="about__timeline-content">
                <div class="about__timeline-meta">
                  <span class="about__timeline-date">{entry.date}</span>
                  <span class="about__timeline-company">{entry.company}</span>
                </div>
                <div class="about__timeline-role">{entry.role}</div>
                <p class="about__timeline-detail">{entry.detail}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
