---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Portfolio from "../components/Portfolio.astro";
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";

const projects = (await getCollection("projects")).sort((a, b) => {
  const featuredDiff = Number(b.data.featured) - Number(a.data.featured);
  if (featuredDiff !== 0) return featuredDiff;
  return Number(b.data.year) - Number(a.data.year);
});
---

<Layout
  title="Charlie Loughran — Digital Designer"
  description="Portfolio of Charlie Loughran, a digital designer based in London, with work spanning UX, product, web and brand."
>
  <Hero />
  <Portfolio projects={projects} />
  <About />
  <Contact />
</Layout>
