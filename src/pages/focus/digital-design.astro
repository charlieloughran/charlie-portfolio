---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import FocusHero from "../../components/FocusHero.astro";
import Portfolio from "../../components/Portfolio.astro";
import About from "../../components/About.astro";
import Contact from "../../components/Contact.astro";

const FOCUS_KEY = "digital-design";

const projects = (await getCollection("projects")).sort(
  (a, b) =>
    (a.data.focusAreas[FOCUS_KEY] ?? 99) - (b.data.focusAreas[FOCUS_KEY] ?? 99)
);
---

<Layout
  title="Charlie Loughran — Digital Designer"
  description="Digital design portfolio of Charlie Loughran, spanning UX, UI, web, and brand."
>
  <FocusHero
    roleLabel="Digital Designer"
    tagline="UX · UI · Web · Brand · Print"
    intro="I work across the full digital design process, from brand direction and information architecture through to live, coded interfaces. Recently I've built a company website from scratch in React, redesigned a dashboard UI for a sustainability platform, and produced brand-consistent work across high-volume, deadline-driven environments for clients in sport, arts, and higher education. I'm equally comfortable owning a project end-to-end or working within an existing team and design system."
    ctaLabel="View my work"
  />
  <Portfolio
    projects={projects}
    eyebrow="Selected Work"
    titleHtml="Case studies &<br /><em>digital design</em>"
    description="A selection of projects across web, product, and brand."
  />
  <About />
  <Contact />
</Layout>
