---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import FocusHero from "../../components/FocusHero.astro";
import Portfolio from "../../components/Portfolio.astro";
import About from "../../components/About.astro";
import Contact from "../../components/Contact.astro";

const FOCUS_KEY = "brand-print";

const projects = (await getCollection("projects")).sort(
  (a, b) =>
    (a.data.focusAreas[FOCUS_KEY] ?? 99) - (b.data.focusAreas[FOCUS_KEY] ?? 99)
);
---

<Layout
  title="Charlie Loughran — Brand & Print Designer"
  description="Brand and print design portfolio of Charlie Loughran: identity, theatre programmes, and print collateral."
>
  <FocusHero
    roleLabel="Brand & Print Designer"
    tagline="Identity · Layout · Theatre Programmes · Print"
    intro="I've spent the last three years designing brand-consistent print and digital collateral for a major UK & Ireland theatre operator, producing theatre programmes for 100+ productions across 50+ venues, and leading rebrands and identity work for clients in arts and education. I introduced paragraph, character, and object styles in InDesign across a design team to improve consistency and speed up production. I care about how a brand feels in print as much as how it looks on screen."
    ctaLabel="View brand & print work"
  />
  <Portfolio
    projects={projects}
    eyebrow="Brand & Print Work"
    titleHtml="Case studies &<br /><em>brand work</em>"
    description="Selected projects with a brand, identity, or print dimension."
  />
  <About />
  <Contact />
</Layout>
