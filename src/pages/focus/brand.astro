---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import FocusHero from "../../components/FocusHero.astro";
import Portfolio from "../../components/Portfolio.astro";
import About from "../../components/About.astro";
import Contact from "../../components/Contact.astro";

const FOCUS_KEY = "brand";

const projects = (await getCollection("projects")).sort(
  (a, b) =>
    (a.data.focusAreas[FOCUS_KEY] ?? 99) - (b.data.focusAreas[FOCUS_KEY] ?? 99)
);
---

<Layout
  title="Charlie Loughran: Brand Designer"
  description="Brand identity and design systems portfolio of Charlie Loughran: identity, sub-brands, and visual systems for arts, education, and sustainability clients."
>
  <FocusHero
    roleLabel="Brand Designer"
    tagline="Identity · Visual Systems · Sub-brands · Guidelines"
    intro="I build brand identities and the systems that keep them consistent as they grow: sub-brand identities that sit comfortably alongside a parent brand, reusable templates that flex across campaigns and channels, and visual languages that work as well on screen as they do in print. I've done this for a university innovation centre, a creative studio, and sports clubs, always with an eye on how the brand needs to scale beyond the first deliverable."
    ctaLabel="View brand work"
  />
  <Portfolio
    projects={projects}
    eyebrow="Brand Work"
    titleHtml="Case studies &<br /><em>brand identity</em>"
    description="Selected projects with a brand identity or visual systems focus."
  />
  <About />
  <Contact />
</Layout>
