---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import FocusHero from "../../components/FocusHero.astro";
import Portfolio from "../../components/Portfolio.astro";
import About from "../../components/About.astro";
import Contact from "../../components/Contact.astro";

const FOCUS_KEY = "web-ui-design";

const projects = (await getCollection("projects")).sort(
  (a, b) =>
    (a.data.focusAreas[FOCUS_KEY] ?? 99) - (b.data.focusAreas[FOCUS_KEY] ?? 99)
);
---

<Layout
  title="Charlie Loughran: Web & UI Designer"
  description="Web and UI design portfolio of Charlie Loughran: websites, dashboards, and design systems."
>
  <FocusHero
    roleLabel="Web & UI Designer"
    tagline="React · Figma · Design Systems · Websites"
    intro="I design and build websites and interfaces, from first wireframe to live code. I recently built the Harvest Communications website from the ground up, covering brand direction, site architecture, and a live React, Vite, and TypeScript build, and redesigned the dashboard UI for a construction-sector decarbonisation tool, including a full colour system and component library. I'm comfortable working in Figma and in code, and I care about the details that make an interface feel considered."
    ctaLabel="View web & UI work"
  />
  <Portfolio
    projects={projects}
    eyebrow="Web & UI Work"
    titleHtml="Case studies &<br /><em>interface design</em>"
    description="Projects spanning websites, dashboards, and design systems."
  />
  <About />
  <Contact />
</Layout>
